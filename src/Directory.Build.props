<Project>
  <PropertyGroup>
    <RedBoltPhysicsBox2DRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RedBoltPhysicsBox2DRoot>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltPhysicsBox2DRoot)/../RedBolt'))</RedBoltRoot>
    <RedBolt2DRoot Condition="'$(RedBolt2DRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltPhysicsBox2DRoot)/../RedBolt.2D'))</RedBolt2DRoot>
    <RedBoltExternalModuleRoot>$(RedBoltPhysicsBox2DRoot)</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.PhysicsBox2D</RedBoltExternalModuleName>
    <RedBoltExternalBuildProjectName>RedBolt.PhysicsBox2D.Build</RedBoltExternalBuildProjectName>
    <RedBoltExternalGeneratorProjectName>RedBolt.PhysicsBox2D.Generator.Dependencies</RedBoltExternalGeneratorProjectName>
    <RedBoltExternalGeneratorProjectPrefix>RedBolt.PhysicsBox2D.Generator.</RedBoltExternalGeneratorProjectPrefix>
    <RedBoltExternalNativeWebProjectName>RedBolt.PhysicsBox2D.Native.Web</RedBoltExternalNativeWebProjectName>
    <RedBoltExternalNativeAndroidProjectName>RedBolt.PhysicsBox2D.Native.Android</RedBoltExternalNativeAndroidProjectName>
    <RedBoltExternalModuleProjectNames>RedBolt.PhysicsBox2D;RedBolt.Bindings.Box2D</RedBoltExternalModuleProjectNames>
    <RedBoltExternalGeneratedBindingsDirectory>redbolt-physics-box2d-native</RedBoltExternalGeneratedBindingsDirectory>
    <RedBoltExternalBindingsSubdirectory>box2d</RedBoltExternalBindingsSubdirectory>
    <RedBoltExternalBindingsProjectName>RedBolt.Bindings.Box2D</RedBoltExternalBindingsProjectName>
    <RedBoltExternalHasNative>true</RedBoltExternalHasNative>
    <RedBoltExternalNativeTargetPrefix>redbolt-physics-box2d</RedBoltExternalNativeTargetPrefix>
    <RedBoltExternalEnabledNativeModules>BOX2D</RedBoltExternalEnabledNativeModules>
    <RedBoltExternalDesktopResourceRoot>$(RedBolt2DRoot)</RedBoltExternalDesktopResourceRoot>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Directory.Build.props" />
  <PropertyGroup>
    <RedBoltExternalModuleEnabled>$(RedBoltPhysicsBox2DEnabled)</RedBoltExternalModuleEnabled>
    <RedBoltExternalModuleBuildProperties>RedBolt2DEnabled=$(RedBolt2DEnabled);RedBoltPhysicsBox2DEnabled=$(RedBoltPhysicsBox2DEnabled)</RedBoltExternalModuleBuildProperties>
    <RedBoltExternalAdditionalProbingPaths>$(RedBolt2DRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/core</RedBoltExternalAdditionalProbingPaths>
  </PropertyGroup>
</Project>
