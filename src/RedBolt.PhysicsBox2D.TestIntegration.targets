<Project>
  <ItemGroup Condition="('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and '$(IsTestProject)' == 'true'">
    <AdditionalProbingPath Include="$(RedBoltPhysicsBox2DRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/core" />
    <AdditionalProbingPath Include="$(RedBoltPhysicsBox2DRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern" />
    <AdditionalProbingPath Include="$(RedBoltPhysicsBox2DRoot)/build/bin/$(Configuration)/host/extern" />
    <AdditionalProbingPath Include="$(RedBoltPhysicsBox2DRoot)/build/bin/$(Configuration)/host/tools" />
  </ItemGroup>
  <Target Name="RedBoltPhysicsBox2DConfigureTestRuntimeAssemblies"
          AfterTargets="RedBoltConfigureRuntimeAssemblies"
          Condition="('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and '$(IsTestProject)' == 'true' and Exists('$(ProjectDepsFilePath)')">
    <RedBoltUseParentRuntimeAssemblies
        DependencyFile="$(ProjectDepsFilePath)"
        MainProjectName="$(AssemblyName)"
        NativeRuntimeDirectory="$(RedBoltPhysicsBox2DRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern/runtimes/$(RedBoltPlatform)/native"
        NativeModuleManifestDirectory="$(RedBoltPhysicsBox2DRoot)/build/native/$(RedBoltPlatform)/generated/native-modules/$(Configuration)"
        RuntimeIdentifier="$(RuntimeIdentifier)">
      <Output TaskParameter="NativeAssets" ItemName="_RedBoltNativeAssets" />
    </RedBoltUseParentRuntimeAssemblies>
  </Target>
</Project>
