<Project>
  <Import Project="$(RedBoltRoot)/src/Directory.Build.targets" />

  <ItemGroup Condition="('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and ('$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true')">
    <AdditionalProbingPath Include="$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/core" />
    <AdditionalProbingPath Include="$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern" />
    <AdditionalProbingPath Include="$(RedBoltRoot)/build/bin/$(Configuration)/host/extern" />
    <AdditionalProbingPath Include="$(RedBoltRoot)/build/bin/$(Configuration)/host/tools" />
    <AdditionalProbingPath Include="$(RedBolt2DRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/core" />
  </ItemGroup>

  <Target Name="RedBoltPhysicsBox2DConfigureBaseRuntimeAssemblies"
          BeforeTargets="RedBoltConfigureRuntimeAssemblies"
          Condition="('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and ('$(OutputType)' == 'Exe' or '$(IsTestProject)' == 'true') and Exists('$(ProjectDepsFilePath)')">
    <RedBoltUseParentRuntimeAssemblies
        DependencyFile="$(ProjectDepsFilePath)"
        MainProjectName="$(AssemblyName)"
        NativeRuntimeDirectory="$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern/runtimes/$(RedBoltPlatform)/native"
        NativeModuleManifestDirectory="$(RedBoltRoot)/build/native/$(RedBoltPlatform)/generated/native-modules/$(Configuration)"
        RuntimeIdentifier="$(RuntimeIdentifier)">
      <Output TaskParameter="NativeAssets" ItemName="_RedBoltNativeAssets" />
    </RedBoltUseParentRuntimeAssemblies>
  </Target>

  <Target Name="RedBoltPhysicsBox2DConfigureProjectReferences"
          BeforeTargets="AssignProjectConfiguration"
          DependsOnTargets="IncludeTransitiveProjectReferences">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'$(RedBoltPlatform)' == 'browser-wasm' and '%(ProjectReference.AdditionalProperties)' == '' and ($([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltPhysicsBox2DRoot)/src/RedBolt/')) or $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBolt2DRoot)/src/RedBolt/'))) and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsBox2D.Generator.Dependencies' and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsBox2D.Native.Web'">
        <AdditionalProperties>RedBoltPlatform=browser-wasm;RedBoltNativePreset=browser-wasm</AdditionalProperties>
      </ProjectReference>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="$([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-')) and '%(ProjectReference.AdditionalProperties)' == '' and ($([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltPhysicsBox2DRoot)/src/RedBolt/')) or $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBolt2DRoot)/src/RedBolt/'))) and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsBox2D.Generator.Dependencies' and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsBox2D.Native.Android'">
        <AdditionalProperties>RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset);RedBoltTargetFramework=$(RedBoltTargetFramework)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>
</Project>
