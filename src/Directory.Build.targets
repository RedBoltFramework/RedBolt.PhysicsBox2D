<Project>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Directory.Build.targets" />

  <Target Name="RedBoltPhysicsBox2DConfigureProjectReferences"
          BeforeTargets="AssignProjectConfiguration"
          DependsOnTargets="IncludeTransitiveProjectReferences">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'$(RedBoltBuildPlatform)' == '' and '$(RedBoltPlatform)' == 'browser-wasm' and '%(ProjectReference.AdditionalProperties)' == '' and ($([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltPhysicsBox2DRoot)/src/RedBolt/')) or $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBolt2DRoot)/src/RedBolt/'))) and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsBox2D.Generator.Dependencies' and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsBox2D.Native.Web'">
        <AdditionalProperties>RedBoltPlatform=browser-wasm;RedBoltNativePreset=browser-wasm</AdditionalProperties>
      </ProjectReference>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="'$(RedBoltBuildPlatform)' == '' and $([System.String]::Copy('$(RedBoltPlatform)').StartsWith('android-')) and '%(ProjectReference.AdditionalProperties)' == '' and ($([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltPhysicsBox2DRoot)/src/RedBolt/')) or $([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBolt2DRoot)/src/RedBolt/'))) and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsBox2D.Generator.Dependencies' and '%(ProjectReference.Filename)' != 'RedBolt.PhysicsBox2D.Native.Android'">
        <AdditionalProperties>RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltNativePreset);RedBoltTargetFramework=$(RedBoltTargetFramework)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>
</Project>
