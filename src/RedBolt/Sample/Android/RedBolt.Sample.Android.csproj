<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.PhysicsBox2D.Sample.Android</AssemblyName>
    <ApplicationId>org.redbolt.physicsbox2d.samples</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The .NET Android compression task caches one ABI per MSBuild process; this sample builds x64 and arm64 in one traversal. -->
    <AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
    <AndroidStripNativeLibraries>true</AndroidStripNativeLibraries>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <OutputType>Exe</OutputType>
    <RedBoltTargetFramework>net10.0-android</RedBoltTargetFramework>
    <TargetFramework>$(RedBoltTargetFramework)</TargetFramework>
    <RedBoltAndroidRuntimeIdentifiers Condition="'$(RedBoltAndroidRuntimeIdentifiers)' == ''">android-arm64;android-x64</RedBoltAndroidRuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(RedBoltPlatform)</RuntimeIdentifier>
    <RuntimeIdentifiers>$(RuntimeIdentifier)</RuntimeIdentifiers>
    <RedBoltBuildAllAndroidPackages Condition="'$(RedBoltBuildAllAndroidPackages)' == ''">true</RedBoltBuildAllAndroidPackages>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TrimMode>partial</TrimMode>
    <RedBoltBaseAndroidNativeOutput>$(RedBoltRoot)/build/bin/$(Configuration)/$(RedBoltPlatform)/extern/runtimes/$(RedBoltPlatform)/native</RedBoltBaseAndroidNativeOutput>
    <RedBoltPhysicsBox2DAndroidNativeOutput>$(RedBoltNativeOutputRoot)</RedBoltPhysicsBox2DAndroidNativeOutput>
    <RedBoltAndroidNdkTriple Condition="'$(RedBoltPlatform)' == 'android-arm64'">aarch64-linux-android</RedBoltAndroidNdkTriple>
    <RedBoltAndroidNdkTriple Condition="'$(RedBoltPlatform)' == 'android-x64'">x86_64-linux-android</RedBoltAndroidNdkTriple>
    <RedBoltAndroidJavaDirectory>$(RedBoltRoot)/build/native/$(RedBoltPlatform)/generated/android/java</RedBoltAndroidJavaDirectory>
    <RedBoltAndroidPackageOutputDirectory>$(RedBoltOutputRoot)/app</RedBoltAndroidPackageOutputDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Core/RedBolt.Core.csproj" />
    <ProjectReference Include="$(RedBolt2DRoot)/src/RedBolt/2D/RedBolt.2D.csproj" />
    <ProjectReference Include="../../PhysicsBox2D/RedBolt.PhysicsBox2D.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform;RedBoltNativePreset;RedBoltTargetFramework" />
    <ProjectReference Include="../../Native/RedBolt.PhysicsBox2D.Native.Android.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
    <Compile Include="../Physics2D/**/*.cs;../Physics2DConstraints/**/*.cs;../Physics2DRope/**/*.cs;../Urho2DIsometricDemo/**/*.cs;../Urho2DPlatformer/**/*.cs;../Utilities2D/**/*.cs"
             Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj"
                      PrivateAssets="all" AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>
  <Target Name="RedBoltConfigureAndroidRuntimeRestore" BeforeTargets="_FilterRestoreGraphProjectInputItems;_GenerateRestoreProjectPathItemsPerFramework;_GenerateRestoreProjectRestoreGraphPerFramework;_GenerateRestoreProjectPathItemsPerFramework">
    <PropertyGroup><RuntimeIdentifiers>$(RedBoltAndroidRuntimeIdentifiers)</RuntimeIdentifiers></PropertyGroup>
  </Target>
  <Target Name="RedBoltPrepareAndroidRuntime" BeforeTargets="_CollectJavaSourceForBinding">
    <MSBuild Projects="$(RedBoltRoot)/src/RedBolt/Native/RedBolt.Native.Android.csproj" Targets="Build" BuildInParallel="false"
             Properties="Configuration=$(Configuration);RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltPlatform);RedBoltTargetFramework=$(RedBoltTargetFramework);AndroidSdkDirectory=$(AndroidSdkDirectory);AndroidNdkDirectory=$(AndroidNdkDirectory);JavaSdkDirectory=$(JavaSdkDirectory)" />
    <MSBuild Projects="$(RedBoltPhysicsBox2DRoot)/src/RedBolt/Native/RedBolt.PhysicsBox2D.Native.Android.csproj" Targets="Build" BuildInParallel="false"
             Properties="Configuration=$(Configuration);RedBoltPlatform=$(RedBoltPlatform);RedBoltNativePreset=$(RedBoltPlatform);RedBoltTargetFramework=$(RedBoltTargetFramework);AndroidSdkDirectory=$(AndroidSdkDirectory);AndroidNdkDirectory=$(AndroidNdkDirectory);JavaSdkDirectory=$(JavaSdkDirectory)" />
    <Copy SourceFiles="$(AndroidNdkDirectory)/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/$(RedBoltAndroidNdkTriple)/libc++_shared.so"
          DestinationFiles="$(RedBoltPhysicsBox2DAndroidNativeOutput)/libc++_shared.so" SkipUnchangedFiles="true" />
    <ItemGroup>
      <AndroidJavaSource Include="$(RedBoltAndroidJavaDirectory)/**/*.java" Bind="false" />
      <AndroidJavaSource Update="$(RedBoltAndroidJavaDirectory)/org/libsdl/app/SDLActivity.java" Bind="true" />
    </ItemGroup>
  </Target>
  <Target Name="RedBoltCollectAndroidNativeLibraries" BeforeTargets="_BuildApkEmbed;_BuildApkFastDev" DependsOnTargets="RedBoltPrepareAndroidRuntime">
    <ItemGroup>
      <AndroidNativeLibrary Remove="$(RedBoltPhysicsBox2DAndroidNativeOutput)/libRedBolt.Native.*.so" />
      <AndroidNativeLibrary Include="$(RedBoltBaseAndroidNativeOutput)/libRedBolt.Native.*.so" />
      <AndroidNativeLibrary Include="$(RedBoltBaseAndroidNativeOutput)/libc++_shared.so" />
      <AndroidNativeLibrary Include="$(RedBoltPhysicsBox2DAndroidNativeOutput)/libRedBolt.Native.*.so" />
    </ItemGroup>
  </Target>
  <Target Name="RedBoltFinalizeAndroidPackage" AfterTargets="Build" Condition="'$(RedBoltProjectBuildEnabled)' == 'true'">
    <PropertyGroup>
      <_RedBoltSignedApk>$(RedBoltOutputDir)/$(ApplicationId)-Signed.apk</_RedBoltSignedApk>
      <_RedBoltPackagedApk>$(RedBoltAndroidPackageOutputDirectory)/RedBolt.PhysicsBox2D.Sample.Android.apk</_RedBoltPackagedApk>
    </PropertyGroup>
    <Error Condition="!Exists('$(_RedBoltSignedApk)')"
           Text="Android package was not produced at '$(_RedBoltSignedApk)'." />
    <MakeDir Directories="$(RedBoltAndroidPackageOutputDirectory)" />
    <Copy SourceFiles="$(_RedBoltSignedApk)" DestinationFiles="$(_RedBoltPackagedApk)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Android package: $(_RedBoltPackagedApk)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" BuildInParallel="false"
             Condition="'$(BuildingSolutionFile)' != 'true' and '$(RedBoltPlatform)' == 'android-x64' and '$(RedBoltBuildAllAndroidPackages)' == 'true' and '$(RedBoltAndroidPackageInnerBuild)' != 'true'"
             Properties="Configuration=$(Configuration);RedBoltPlatform=android-arm64;RedBoltNativePreset=android-arm64;RedBoltBuildAllAndroidPackages=false;RedBoltAndroidPackageInnerBuild=true" />
  </Target>
  <ItemGroup>
    <AndroidAsset Include="$(RedBoltRoot)/bin/CoreData/**/*" Link="CoreData/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(RedBolt2DRoot)/bin/CoreData/**/*" Link="CoreData/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(RedBoltRoot)/bin/Data/**/*" Link="Data/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(RedBolt2DRoot)/bin/Data/**/*" Link="Data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
