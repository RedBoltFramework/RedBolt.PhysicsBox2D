<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>
  <ItemGroup>
    <_RedBoltExternalDesktopProject Include="$(RedBolt2DRoot)/src/RedBolt/2D/RedBolt.2D.csproj" Condition="'$(RedBoltPhysicsBox2DEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="../Native/RedBolt.PhysicsBox2D.Native.csproj;../Native/Box2D/RedBolt.Bindings.Box2D.csproj;../PhysicsBox2D/RedBolt.PhysicsBox2D.csproj" Condition="'$(RedBoltPhysicsBox2DEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="../Sample/*/*.csproj" Exclude="../Sample/Android/*.csproj;../Sample/Web/*.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="$(RedBoltTestsProject)" Condition="'$(RedBoltTestsEnabled)' == 'true' and Exists('$(RedBoltTestsProject)')" />
    <_RedBoltExternalAndroidProject Include="$(RedBolt2DRoot)/src/RedBolt/2D/RedBolt.2D.csproj;../Native/RedBolt.PhysicsBox2D.Native.Android.csproj;../Native/Box2D/RedBolt.Bindings.Box2D.csproj;../PhysicsBox2D/RedBolt.PhysicsBox2D.csproj" Condition="'$(RedBoltPhysicsBox2DEnabled)' == 'true'" />
    <_RedBoltExternalAndroidProject Include="../Sample/Android/RedBolt.Sample.Android.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
    <_RedBoltExternalWebProject Include="$(RedBolt2DRoot)/src/RedBolt/2D/RedBolt.2D.csproj;../Native/RedBolt.PhysicsBox2D.Native.Web.csproj;../Native/Box2D/RedBolt.Bindings.Box2D.csproj;../PhysicsBox2D/RedBolt.PhysicsBox2D.csproj" Condition="'$(RedBoltPhysicsBox2DEnabled)' == 'true'" />
    <_RedBoltExternalWebProject Include="../Sample/Web/RedBolt.Sample.Web.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
  </ItemGroup>
  <Target Name="RedBoltPhysicsBox2DValidateDependency" BeforeTargets="RedBoltExternalValidateBuildConfiguration">
    <Error Condition="'$(RedBoltPhysicsBox2DEnabled)' == 'true' and !Exists('$(RedBolt2DRoot)/src/RedBolt/2D/RedBolt.2D.csproj')" Text="The physics samples require sibling RedBolt.2D at '$(RedBolt2DRoot)'." />
  </Target>
  <Import Project="$(RedBoltRoot)/src/RedBolt/ExternalModule/Build.targets" />
</Project>
